{
  "appId": "com.growthbuddy.app",
  "appName": "Growth Buddy",
  "webDir": "www",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "CapacitorCookies": {
      "enabled": true
    },
    "SplashScreen": {
      "launchAutoHide": false,
      "launchFadeOutDuration": 200,
      "backgroundColor": "#F97316",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP",
      "androidSplashResourceName": "splash"
    }
  }
}
