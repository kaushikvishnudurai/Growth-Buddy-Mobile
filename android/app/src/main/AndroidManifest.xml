<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Share to Growth Buddy" for text: a bank SMS shared in is captured
                 into Money (CapturePlugin), any other text opens Quick add. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Money's automatic capture: UPI and bank app payment notifications
             (CaptureNotificationListener.APPS only). Bound by Android only after the
             user turns on this app's "Notification access", which the app asks for
             behind its own consent card. No Play declaration form exists for it; the
             in-app disclosure is what the User Data policy requires. -->
        <service
            android:name="com.growthbuddy.capture.CaptureNotificationListener"
            android:label="@string/app_name"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- SMS capture release ONLY (MOBILE.md, "SMS capture release"). Uncomment
             together with the two SMS permissions at the end of this file, in a
             release of its own: Play holds the whole release while it reviews them.
        <receiver
            android:name="com.growthbuddy.capture.CaptureSmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
        -->

        <!-- Notification buttons (Done, Snooze, +250 ml) handled without opening
             the app. The patched LocalNotifications plugin (patches/) sends a press
             here whenever a receiver for this action exists. Not exported: only our
             own PendingIntents reach it. -->
        <receiver
            android:name="com.growthbuddy.actions.NotificationActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="${applicationId}.NOTIFICATION_ACTION" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The food barcode scanner's getUserMedia. Capacitor's BridgeWebChromeClient
         turns the WebView's onPermissionRequest into the runtime CAMERA prompt, but
         Android denies a permission the manifest never declared without showing
         anything, so the web side read "refused" for a question never asked.
         required="false": a phone without a camera can still install the app. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Recording a custom reminder tone (chime.js recordCustomChime, getUserMedia
         audio). BridgeWebChromeClient asks for MODIFY_AUDIO_SETTINGS and RECORD_AUDIO
         together and grants the WebView only when both come back granted; with
         MODIFY_AUDIO_SETTINGS undeclared that was a silent "blocked" every time.
         RECORD_AUDIO also arrives from the speech-recognition plugin, but is declared
         here so the recorder does not depend on that plugin staying installed.
         MODIFY_AUDIO_SETTINGS is a normal permission: granted at install, no prompt. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- A reminder is an alarm the user set, so it has to land on the minute.
         Without this, targetSdk 36 means canScheduleExactAlarms() is false by
         default on Android 14+, the plugin silently falls back to
         setAndAllowWhileIdle(), and Doze batches a 09:00 reminder to whenever
         it next feels like waking - usually 9-15 minutes late, sometimes more.
         USE_EXACT_ALARM is granted at install with no prompt; SCHEDULE_EXACT_ALARM
         (declared by the plugin) is not, on 14+.
         ponytail: no in-app fallback UI. The plugin exposes
         checkExactNotificationSetting/changeExactNotificationSetting to walk the
         user to Settings - add that only if Play refuses the USE_EXACT_ALARM
         declaration. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Health Connect, read only. Everything the Health screen shows comes from
         what the phone, Fit, Samsung Health or a watch already recorded; we run no
         sensor or service of our own, so no ACTIVITY_RECOGNITION and no battery cost.
         Kept: the READ_* for exactly HEALTH_READ in the web repo's scripts/native.js
         (the plugin maps each type to HealthPermission.getReadPermission(record):
         calories -> ACTIVE_CALORIES_BURNED, flightsClimbed -> FLOORS_CLIMBED,
         heartRateVariability -> HEART_RATE_VARIABILITY (the RMSSD record),
         workouts -> EXERCISE; a workout's distance/calories come from DISTANCE and
         ACTIVE_CALORIES_BURNED, already kept).
         @capgo/capacitor-health declares read+write for ~25 types; Play asks for a
         justification of every health permission an app declares, so every WRITE_*
         and every other READ_* is stripped. Add one back when a feature reads it, in
         the same change as HEALTH_READ, and give it a line in MOBILE.md.
         ponytail: no READ_HEALTH_DATA_HISTORY, so Health Connect returns at most 30
         days before the first grant; a weight logged two months before install is
         not seen. Add it here and pass requestHistoryAccess if that matters. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.WRITE_STEPS" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.WRITE_DISTANCE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.WRITE_ACTIVE_CALORIES_BURNED" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.WRITE_HEART_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.WRITE_WEIGHT" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.WRITE_SLEEP" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_RESPIRATORY_RATE" />
    <uses-permission android:name="android.permission.health.WRITE_RESPIRATORY_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_OXYGEN_SATURATION" />
    <uses-permission android:name="android.permission.health.WRITE_OXYGEN_SATURATION" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.WRITE_RESTING_HEART_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE_VARIABILITY" />
    <uses-permission android:name="android.permission.health.WRITE_HEART_RATE_VARIABILITY" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_VO2_MAX" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_VO2_MAX" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_BLOOD_PRESSURE" />
    <uses-permission android:name="android.permission.health.WRITE_BLOOD_PRESSURE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_BLOOD_GLUCOSE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_BLOOD_GLUCOSE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_BODY_TEMPERATURE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_BODY_TEMPERATURE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_HEIGHT" />
    <uses-permission android:name="android.permission.health.WRITE_HEIGHT" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_FLOORS_CLIMBED" />
    <uses-permission android:name="android.permission.health.WRITE_FLOORS_CLIMBED" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_BODY_FAT" />
    <uses-permission android:name="android.permission.health.WRITE_BODY_FAT" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_BASAL_BODY_TEMPERATURE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_BASAL_BODY_TEMPERATURE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_BASAL_METABOLIC_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_BASAL_METABOLIC_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_TOTAL_CALORIES_BURNED" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_MINDFULNESS" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_MINDFULNESS" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_HYDRATION" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_HYDRATION" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_NUTRITION" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_NUTRITION" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />

    <!-- SMS capture release ONLY (see the receiver above and MOBILE.md). Use case
         on the Play declaration form: "SMS-based money management".
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    -->
</manifest>
