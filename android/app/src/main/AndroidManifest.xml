<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- A reminder is an alarm the user set, so it has to land on the minute.
         Without this, targetSdk 36 means canScheduleExactAlarms() is false by
         default on Android 14+, the plugin silently falls back to
         setAndAllowWhileIdle(), and Doze batches a 09:00 reminder to whenever
         it next feels like waking - usually 9-15 minutes late, sometimes more.
         USE_EXACT_ALARM is granted at install with no prompt; SCHEDULE_EXACT_ALARM
         (declared by the plugin) is not, on 14+.
         ponytail: no in-app fallback UI. The plugin exposes
         checkExactNotificationSetting/changeExactNotificationSetting to walk the
         user to Settings - add that only if Play refuses the USE_EXACT_ALARM
         declaration. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
</manifest>
